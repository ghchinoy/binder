{
  "name": "astro-okf",
  "version": "0.1.0",
  "description": "Astro Content Layer loader for Open Knowledge Format (OKF) v0.2 bundles, with derived trust tiers rendered as derived.",
  "keywords": [
    "astro",
    "astro-loader",
    "astro-integration",
    "content-layer",
    "okf",
    "knowledge-base",
    "provenance"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/ghchinoy/binder/tree/main/packages/astro-okf#readme",
  "bugs": {
    "url": "https://github.com/ghchinoy/binder/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghchinoy/binder.git",
    "directory": "packages/astro-okf"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:example": "astro build --root example",
    "test": "node --test \"test/*.test.mjs\"",
    "test:example": "node --test \"test/example/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "astro": "7.2.4",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
