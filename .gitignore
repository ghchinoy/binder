# Go
/bin/
/dist/
*.test
*.out

# JavaScript workspace (npm workspaces root over packages/* and site/).
# /dist/ above is root-anchored, so it does NOT cover a package's build output;
# and there was no node_modules/ rule at all before the workspace root existed.
node_modules/
packages/*/dist/
packages/*/example/dist/
packages/*/example/.astro/

# Python bytecode cache from the CI helper scripts under scripts/ (e.g.
# check-transcript-versions.py, issue #169). Never a committable artifact.
__pycache__/
*.pyc
